allowHTML: true
allowCustomResources: true
outputFormat: html

interface:
  toc-header: false
  favicon-src: /favicon.svg

resources:
  style:
    - _assets/style/custom.css
    - _assets/style/accessibility.css
    - _assets/style/content-flow.css
    - _assets/style/standalone.css
    - _assets/style/home.css
    - _assets/style/active-projects.css
    - _assets/style/journal.css
    - _assets/style/project-timeline.css
    - _assets/style/command-palette.css
    - _assets/style/engineering-graph.css
    - _assets/style/resume.css
    - _assets/style/experience-refinement.css
    - _assets/style/photo-stories.css
    - _assets/style/photo-embedded.css
    - _assets/style/collaboration.css
    - _assets/style/header-utilities.css
  script:
    - _assets/script/custom.js
    - _assets/script/diplodoc-runtime-a11y.js
    - _assets/script/command-palette.js
    - _assets/script/engineering-graph.js
    - _assets/script/photo-stories.js
    - _assets/script/header-utilities.js
    - _assets/script/header-chrome-unifier.js
    - _assets/script/header-list-semantics.js

search:
  provider: local
  tolerance: 2
  confidence: phrased

plugins:
  - "@diplodoc/search-extension"

docs-viewer:
  themes: ['dark']
